# Supabase (local dev - mặc định khi chạy `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sẽ-lấy-từ-output-của-supabase-start>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000